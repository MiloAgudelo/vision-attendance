# ---------------------------------------------------------------------------
# vision-attendance — plantilla de variables de entorno
#
# Copia este archivo a `.env` (que NO se versiona) y ajusta los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Cadena de conexión a PostgreSQL que usa el servidor (Drizzle / postgres.js).
# Valor de DESARROLLO LOCAL: apunta al PostgreSQL 17 embebido que levanta
# `pnpm db:up` (puerto 54322, el mismo que usa `supabase start`).
# En producción se reemplaza por la cadena de conexión de Supabase.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Cupo básico de `POST /api/v1/events` por dispositivo autenticado (ventana deslizante).
# `0` desactiva el límite. Ver docs/security.md.
EVENTS_RATE_LIMIT=120
EVENTS_RATE_LIMIT_WINDOW_MS=60000

# URL pública del proyecto de Supabase (la usa el navegador para Supabase Auth).
# La conecta el responsable del proyecto; en local puede quedar vacía.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública de Supabase (solo Auth: el navegador NUNCA lee datos
# directamente, todas las tablas tienen RLS deny-all).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de rol de servicio de Supabase. SECRETA: solo servidor, nunca el cliente.
# Solo se necesita si se usa la API de Supabase desde el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Zona horaria de referencia del proyecto. Los horarios se definen en hora local
# de Bogotá y los timestamps se almacenan en UTC (RN10).
TZ=America/Bogota
